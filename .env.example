# HOSTINGER & NODE.JS RUNTIME CONFIGURATION
PORT="3000"
NODE_ENV="production"
APP_URL="https://yourdomain.com"

# GEMINI_API_KEY: Required for server-side AI Stylist, Customer Support Concierge & Ghost Mannequin Generation (@google/genai).
GEMINI_API_KEY="your_gemini_api_key_here"

# RAZORPAY PAYMENT GATEWAY CONFIGURATION (Server-Side Only)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# PAYMENT_DEMO_MODE: Set to "true" to allow safe simulated payments, or "false" for live production payments.
PAYMENT_DEMO_MODE="false"

# DIRECT UPI RECONCILIATION CONFIGURATION
MERCHANT_UPI_ID="ahuzafashion@icici"
MERCHANT_NAME="AHUZA APPAREL PRIVATE LIMITED"
SUPPORT_PHONE="9550582277"

# SESSION_SECRET: Server-side secret used to sign HMAC authentication tokens.
SESSION_SECRET="ahuza_prod_hmac_session_secret_9f8e7d6c5b4a3210"

# GOOGLE APPS SCRIPT ORDER WEBHOOK URL (Optional Automated Sheet Sync)
GOOGLE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/your_script_id/exec"
